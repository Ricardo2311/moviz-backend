# Copy this file to .env and fill in the values before running the server.
# Generate SECRET_KEY with: python -c "import secrets; print(secrets.token_hex(32))"

DATABASE_URL=sqlite:///./moviz.db
TMDB_API_KEY=your_tmdb_api_key_here
TMDB_READ_TOKEN=your_tmdb_read_token_here

# REQUIRED — must be at least 32 characters, no weak defaults
SECRET_KEY=replace_this_with_output_of_secrets_token_hex_32

ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=10080
RESET_TOKEN_EXPIRE_MINUTES=30

# Optional — for admin endpoints (critic approval, etc.)
ADMIN_SECRET_KEY=

# REQUIRED for CineBot chatbot — get your key at console.anthropic.com
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# Optional — override the Claude model used by CineBot
# Default: claude-haiku-4-5-20251001 (fast, cost-effective)
# Upgrade: claude-sonnet-5 (higher quality, slower)
# CLAUDE_CHAT_MODEL=claude-haiku-4-5-20251001

# Optional — for password reset emails
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=

# REQUIRED in production — comma-separated list of allowed CORS origins
# Example: CORS_ORIGINS=https://moviz.app,capacitor://localhost
CORS_ORIGINS=

# REQUIRED in production — base URL for serving uploaded files (profile images, etc.)
# Example: PUBLIC_ASSET_BASE_URL=https://api.moviz.app
PUBLIC_ASSET_BASE_URL=http://localhost:8000

# Storage backend — "local" (default, dev only) or "s3" (production)
# STORAGE_BACKEND=s3
#
# Required when STORAGE_BACKEND=s3:
# S3_BUCKET_NAME=your-bucket-name
# S3_ACCESS_KEY_ID=your-access-key-id
# S3_SECRET_ACCESS_KEY=your-secret-access-key
# S3_PUBLIC_URL_BASE=https://your-bucket.r2.dev   # public URL base for objects
#
# Optional S3 settings:
# S3_ENDPOINT_URL=https://<account>.r2.cloudflarestorage.com  # R2 / non-AWS providers
# S3_REGION=us-east-1

# Optional — set to comma-separated IPs of your reverse proxy / load balancer
# so rate limiting works correctly per end-user IP rather than per proxy IP.
# Example: TRUSTED_PROXY_IPS=10.0.0.1,10.0.0.2
# TRUSTED_PROXY_IPS=

# ── Monetização ─────────────────────────────────────────────────────────────
# Limites diários do CineBot (padrão: free 5 + anúncios, Premium 30)
# CHAT_FREE_DAILY_LIMIT=5
# CHAT_PREMIUM_DAILY_LIMIT=30

# AdMob — em produção use true: o bônus por anúncio só é creditado pelo callback
# assinado do Google. URL do callback (cadastrar no console AdMob, bloco recompensado):
#   https://<sua-api>/api/ads/admob-ssv
ADMOB_REQUIRE_SSV=false

# RevenueCat (assinatura Premium)
# Secret key (sk_...) — Project settings > API keys. NUNCA no frontend.
REVENUECAT_SECRET_API_KEY=
# Valor exato do header Authorization configurado no webhook do RevenueCat
# (URL do webhook: https://<sua-api>/api/webhooks/revenuecat). Gere com secrets.token_hex(32).
REVENUECAT_WEBHOOK_AUTH=
# Identificador do entitlement criado no RevenueCat
REVENUECAT_ENTITLEMENT_ID=premium

# ── E-mail (reset de senha) — Resend tem prioridade sobre SMTP ─────────────────
# RESEND_API_KEY=
# FRONTEND_APP_URL=https://moviz.app